# App environment: "prod" keeps DDoS shield + rate limiter ON.
# "test" or "perf" disables them for load testing (k6, etc).
APP_ENV=prod

# Server (API)
SERVER_PORT=8000

# Postgres (untuk API & Worker)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=capstone

# MongoDB (untuk logs & flexible data)
MONGO_URI=mongodb://mongo:capstone123@mongo:27017/capstone?authSource=admin
MONGO_USER=mongo
MONGO_PASSWORD=capstone123

# Redis (caching & rate limiting)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka (message queue)
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=transactions
KAFKA_GROUP_ID=worker-group

# Rate Limiting (per X-User-ID, falling back to client IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# PgBouncer (connection pooling)
PGBOUNCER_ADDR=pgbouncer:6432
PGBOUNCER_ADMIN_ADDR=postgres://postgres:capstone123@pgbouncer:6432/pgbouncer

LOG_LEVEL=debug  # atau info untuk prod
# Max concurrent in-flight requests before DDoS shield returns 503 (prod only)
SHIELD_MAX_INFLIGHT=500

# warn keeps logs quiet on the hot path. Set to info or debug for local dev.
LOG_LEVEL=warn

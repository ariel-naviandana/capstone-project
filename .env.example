# Server (API)
SERVER_PORT=8000

# Postgres (untuk API & Worker)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=capstone

# MongoDB (untuk logs & flexible data)
MONGO_URI=mongodb://mongo:capstone123@mongo:27017/capstone?authSource=admin
MONGO_USER=mongo
MONGO_PASSWORD=capstone123

# Redis (caching & rate limiting)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka (message queue)
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=transactions
KAFKA_GROUP_ID=worker-group

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

LOG_LEVEL=debug  # atau info untuk prod